{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mtga:ai-review:v2",
  "title": "MTGA cloud AI review V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "match_id",
    "game_number",
    "source_content_hash",
    "policy_version",
    "generated_at",
    "generator",
    "provenance",
    "coverage",
    "summary",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "MTGA_AI_REVIEW_V2"
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
    },
    "game_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "source_content_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9/;_.-]{0,79}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "chatgpt-cloud-agent"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "evidence",
        "context_sources",
        "summary_may_use_future"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "evidence": {
          "const": "published-player-perspective"
        },
        "context_sources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "uniqueItems": true
        },
        "summary_may_use_future": {
          "const": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "actions_total",
        "states_resolved",
        "inspected",
        "limitations"
      ],
      "properties": {
        "scope": {
          "enum": [
            "sampled",
            "all_actions"
          ]
        },
        "actions_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "states_resolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "inspected": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anchor",
              "boundary"
            ],
            "properties": {
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^T[0-9]+-A[0-9]+$"
              },
              "boundary": {
                "enum": [
                  "before",
                  "after"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "overview",
        "strengths",
        "improvements",
        "limitations"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "[\\u3400-\\u9fff]"
        },
        "overview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1300,
          "pattern": "[\\u3400-\\u9fff]"
        },
        "strengths": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "uniqueItems": true
        },
        "improvements": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "uniqueItems": true
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor",
          "boundary",
          "importance",
          "assessment",
          "confidence",
          "title",
          "observation",
          "suggestion",
          "rationale",
          "limitation",
          "cards"
        ],
        "properties": {
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^T[0-9]+-A[0-9]+$"
          },
          "boundary": {
            "enum": [
              "before",
              "after"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1300,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "[\\u3400-\\u9fff]"
          },
          "cards": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 179,
              "pattern": "^[^\\u3400-\\u9fff]+$"
            },
            "uniqueItems": true
          },
          "importance": {
            "enum": [
              "critical",
              "major",
              "normal"
            ]
          },
          "assessment": {
            "enum": [
              "suggestion",
              "possible_error",
              "positive"
            ]
          }
        }
      },
      "uniqueItems": true
    }
  }
}
